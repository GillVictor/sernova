# Copy to .env (ignored by git) and adapt. Never commit real values.

# Database container (docker compose). Choose any local password.
POSTGRES_PASSWORD=change-me-locally

# --- API settings (read as environment variables, ASP.NET Core style: "__" separates levels) ---
# Browser origins allowed to call the API (the administration). Empty = none. https only, http for localhost.
#Cors__AllowedOrigins__0=http://localhost:3000

# Rate limits (provisional values, see open point OP-38)
#RateLimiting__Global__PermitLimit=100
#RateLimiting__Global__WindowSeconds=60
#RateLimiting__Strict__PermitLimit=5
#RateLimiting__Strict__WindowSeconds=60

# Log level (Serilog) and OpenAPI document outside Development
#Serilog__MinimumLevel__Default=Information
#OpenApi__Enabled=false
